{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rushr-indexer",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Catch-up steps over busy ranges (big airdrops) need more than the default 30s of CPU.
  "limits": { "cpu_ms": 300000 },
  "dev": { "port": 8788 },
  // Served only on the custom domain; workers.dev and preview URLs would expose the account name.
  "routes": [{ "pattern": "api.rushr.trade", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      { "name": "CHAIN_POLLER", "class_name": "ChainPoller" },
      { "name": "LIVE_FEED", "class_name": "LiveFeed" },
      { "name": "BACKFILLER", "class_name": "Backfiller" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ChainPoller", "LiveFeed"] },
    { "tag": "v2", "new_sqlite_classes": ["Backfiller"] }
  ],
  "queues": {
    "producers": [{ "binding": "ENRICH_QUEUE", "queue": "rushr-enrich" }],
    "consumers": [{ "queue": "rushr-enrich", "max_batch_size": 50, "max_batch_timeout": 2, "max_concurrency": 2 }]
  },
  // Neon (aws-ap-southeast-1) through Hyperdrive. Locally: the docker-compose Postgres.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "0f02eaf63063426a96a49de0829525bf",
      "localConnectionString": "postgres://rushr:rushr@localhost:5433/rushr"
    }
  ],
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "CHAIN_ID": "4663",
    "BLOCKSCOUT_API": "https://robinhoodchain.blockscout.com/api/v2"
  }
  // Secrets (set with `wrangler secret put`, locally in .dev.vars): RPC_URL, DATABASE_URL, ADMIN_TOKEN
}
