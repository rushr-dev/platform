{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rushr-indexer",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Run next to the database (Neon, aws-ap-southeast-1): every request makes several round trips to it.
  "placement": { "mode": "targeted", "region": "aws:ap-southeast-1" },
  // Catch-up steps over busy ranges (big airdrops) need more than the default 30s of CPU.
  "limits": { "cpu_ms": 300000 },
  "dev": { "port": 8788 },
  // Served only on the custom domain; workers.dev and preview URLs would expose the account name.
  "routes": [{ "pattern": "api.rushr.trade", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      { "name": "CHAIN_POLLER", "class_name": "ChainPoller" },
      { "name": "LIVE_FEED", "class_name": "LiveFeed" },
      { "name": "BACKFILLER", "class_name": "Backfiller" },
      { "name": "GATEWAY", "class_name": "Gateway" },
      { "name": "HYDRATOR", "class_name": "TokenHydrator" },
      { "name": "RPC_BUDGET", "class_name": "RpcBudget" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ChainPoller", "LiveFeed"] },
    { "tag": "v2", "new_sqlite_classes": ["Backfiller"] },
    { "tag": "v3", "new_sqlite_classes": ["Gateway"] },
    { "tag": "v4", "new_sqlite_classes": ["TokenHydrator", "RpcBudget"] }
  ],
  "queues": {
    "producers": [
      { "binding": "ENRICH_QUEUE", "queue": "rushr-enrich" },
      { "binding": "METADATA_QUEUE", "queue": "rushr-metadata" }
    ],
    "consumers": [
      { "queue": "rushr-enrich", "max_batch_size": 50, "max_batch_timeout": 2, "max_concurrency": 4 },
      { "queue": "rushr-metadata", "max_batch_size": 10, "max_batch_timeout": 1, "max_concurrency": 4, "max_retries": 10 }
    ]
  },
  // Database: Neon's pooled endpoint (aws-ap-southeast-1) in the DATABASE_URL secret, *without*
  // channel_binding=require: postgres.js can't do channel binding in the Workers runtime and Neon then
  // closes the connection. Hyperdrive config rushr-db (0f02eaf6…) is unused: queries through it stalled.
  // Keep each invocation under Workers' 6 simultaneous connections (postgres `max` in the code).
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "CHAIN_ID": "4663",
    "BLOCKSCOUT_API": "https://robinhoodchain.blockscout.com/api/v2",
    // Stream v3/v2 swaps of the busiest tracked pools (address-filtered, max 500) over the socket.
    // Approved 2026-11-12 at ~+4.3 GB/month; measured bytes are in /health live.socketBytes.
    "LIVE_PAIRS": "1"
  }
  // Secrets (set with `wrangler secret put`, locally in .dev.vars): RPC_URL, DATABASE_URL, ADMIN_TOKEN
}
