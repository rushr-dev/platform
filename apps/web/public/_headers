# Cloudflare static-asset headers. Art and logos change rarely and keep their names when they do,
# so cache them for a week and revalidate in the background after that.
/art/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
/logo-mark-64.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
/og-rushr.jpg
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
/brand/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
# The service worker must always be re-checked, so updates reach installed apps right away.
/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /
/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=3600
/pwa/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
