{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rushr-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  // Served only on the custom domains; workers.dev and preview URLs would expose the account name.
  "routes": [
    { "pattern": "rushr.trade", "custom_domain": true },
    { "pattern": "www.rushr.trade", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "vars": { "NEXT_PUBLIC_API_URL": "https://api.rushr.trade" }
}
