---
// Rushr override: square icon buttons like the landing nav, plus the dark "Open app" pill.
import config from 'virtual:starlight/user-config';
import { Icon } from '@astrojs/starlight/components';
const links = config.social || [];
---

<div class="rushr-social">
	{links.map(({ label, href, icon }) => (
		<a {href} rel="me" class="icon-btn" title={label}>
			<span class="sr-only">{label}</span>
			<Icon name={icon} size="1rem" />
		</a>
	))}
	<a href="https://app.rushr.trade" class="open-app">Open app</a>
</div>

<style>
	.rushr-social {
		display: flex;
		align-items: center;
		gap: 0.4rem;
	}
	.icon-btn {
		display: grid;
		place-items: center;
		width: 2.1rem;
		height: 2.1rem;
		border: 1px solid var(--sl-color-hairline);
		border-radius: 8px;
		color: var(--sl-color-gray-2);
		background: var(--rushr-surface);
	}
	.icon-btn:hover {
		color: var(--sl-color-white);
		border-color: var(--sl-color-gray-4);
	}
	.open-app {
		margin-left: 0.35rem;
		padding: 0.5rem 0.95rem;
		border-radius: 8px;
		background: var(--sl-color-white);
		color: var(--sl-color-black);
		font-weight: 600;
		font-size: 0.875rem;
		text-decoration: none;
		white-space: nowrap;
	}
	.open-app:hover {
		opacity: 0.88;
	}
</style>
