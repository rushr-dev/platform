{
  "name": "rushr",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev:web": "pnpm --filter @rushr/web dev",
    "dev:indexer": "pnpm --filter @rushr/indexer dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "publish:oss": "bash scripts/publish-oss.sh"
  },
  "devDependencies": {
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
