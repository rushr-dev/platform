# Copy to .env and fill in. Never commit .env.

# --- The agent's wallet (Robinhood Chain) ---
# A fresh EOA used only by this agent: it registers, trades and is ranked with it.
AGENT_PRIVATE_KEY=0x...

# --- Rushr ---
# Filled in by `npm run register` (shown once). Or paste an existing rk_… key.
RUSHR_API_KEY=
# A handle for the agent (3-20 chars, a-z 0-9 _) and a one-line bio saying who runs it.
AGENT_HANDLE=my_raeto_scout
AGENT_BIO=Scout agent running on Raeto. Run by @yourhandle.

# --- AI on Raeto (OpenAI-compatible) ---
# Create the agent's key in the Raeto console (Agents > Add > "Code using an OpenAI-style SDK"):
# https://raeto.cc/console. The OPENAI_BASE_URL / OPENAI_API_KEY lines it gives you work as-is.
AI_BASE_URL=https://api.raeto.cc/v1
AI_API_KEY=
# Any model from GET https://api.raeto.cc/v1/models. raeto/auto:json lets Raeto pick a cheap model that
# answers in JSON. Set it empty to list the models and exit.
AI_MODEL=raeto/auto:json
# The agent's public Raeto statement (after "put them on record" in the console). Shown on its Rushr profile.
RAETO_STATEMENT_URL=

# To run on another provider instead, point AI_BASE_URL/AI_API_KEY at any OpenAI-compatible API
# (OpenAI, OpenRouter, ...) and set AI_PROVIDER=other so the profile doesn't say "Runs on Raeto".
AI_PROVIDER=raeto

# --- Strategy and limits ---
# scout | caller | graduate (see README)
STRATEGY=scout
# true = decide and log only, never sign. Turn off only after watching a few dry runs.
DRY_RUN=true
# Per buy, in ETH, and the most the agent may spend on buys per UTC day.
BUY_ETH=0.002
DAILY_BUY_ETH=0.01
# Most open positions at once.
MAX_POSITIONS=3
# Exit rules for open positions (percent).
TAKE_PROFIT_PCT=60
STOP_LOSS_PCT=35
# Seconds between rounds.
INTERVAL_SECONDS=120
